# apple silicon or intel; sets HOMEBREW_PREFIX
for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x $b ] && eval "$($b shellenv zsh)" && break
done

# history: shared between open shells right away, with timestamps (`history` shows them)
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=10000
setopt extended_history share_history hist_expire_dups_first hist_ignore_dups \
  hist_ignore_space hist_verify
alias history='fc -il 1'

# completion: a menu walked with arrows, case-insensitive, matches inside words too;
# -i skips completion dirs with unsafe permissions instead of asking about them
zmodload zsh/complist
autoload -Uz compinit && compinit -i
autoload -Uz bashcompinit && bashcompinit
setopt complete_in_word always_to_end
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' special-dirs true
zstyle ':completion:*' list-colors ''

# emacs keys; up/down search history by what is typed; ctrl-w and alt-backspace stop at / and -
bindkey -e
WORDCHARS=''
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search edit-command-line
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
zle -N edit-command-line
bindkey '^[[A' up-line-or-beginning-search '^[OA' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search '^[OB' down-line-or-beginning-search
bindkey '^[[H' beginning-of-line '^[[F' end-of-line '^[[3~' delete-char
bindkey '^[[1;5C' forward-word '^[[1;5D' backward-word
bindkey '^[[Z' reverse-menu-complete
# ctrl-x ctrl-e: the line in $EDITOR
bindkey '^X^E' edit-command-line
# quotes ? and & in a pasted or typed url
autoload -Uz url-quote-magic bracketed-paste-magic
zle -N self-insert url-quote-magic
zle -N bracketed-paste bracketed-paste-magic

# a folder name alone cds into it, cd keeps a stack (`cd -<tab>`)
setopt auto_cd auto_pushd pushd_ignore_dups pushd_minus
setopt interactive_comments long_list_jobs
# no ctrl-s / ctrl-q freezing the terminal
unsetopt flow_control
alias -- -='cd -'
alias -g ...='../..'
alias -g ....='../../..'
alias md='mkdir -p'
# mkdir -p and cd into it
take() { mkdir -p -- "$1" && cd -- "$1" }
export LSCOLORS=Gxfxcxdxbxegedabagacad
alias ls='ls -G'
export PAGER=less LESS=-R

# terminal / tmux pane title: the folder at the prompt, the command while it runs;
# tmux.conf leaves both out of the tab label
autoload -Uz add-zsh-hook
_title_precmd() { print -Pn '\e]0;%~\a' }
# the first word that is not VAR=x, sudo or a flag
_title_preexec() {
  setopt local_options extended_glob
  print -rn -- $'\e]0;'"${${1[(wr)^(*=*|sudo|-*)]}//[[:cntrl:]]}"$'\a'
}
add-zsh-hook precmd _title_precmd
add-zsh-hook preexec _title_preexec

# onedark warmer or light (`theme`): palette for the prompt below, exports for bat, delta, fzf...
# Read again at a prompt after `theme` switched it, from this shell or another one
source ~/.config/theme/env.sh
_theme_sync() {
  local f=${XDG_STATE_HOME:-$HOME/.local/state}/theme t=dark
  [[ -r $f && $(<$f) == light ]] && t=light
  [[ $t == $THEME ]] || source ~/.config/theme/env.sh
}
# a new iTerm window opens with the default profile, dark; under tmux `theme` switches the terminal
[[ -z $TMUX && $TERM_PROGRAM == iTerm.app && $THEME == light ]] && print -n "\e]1337;SetProfile=$thm_iterm\a"

# Prompt: "dotfiles/files/tmux ❯", the path from the repo root (outside a repo from ~),
# ❯ red after a failed command. Right: the exit code with the signal name (130 INT), how
# long the command took (from 0.5s), background jobs. The branch only outside tmux, its
# status line has it. After Enter the line collapses to "dotfiles ❯ cmd" with only the
# start time on the right, so scrollback keeps when it ran.
zmodload zsh/datetime
autoload -Uz add-zle-hook-widget

_prompt_preexec() { _prompt_start=$EPOCHREALTIME }

# 850ms, 12.4s, 3m05s, 1h02m into REPLY
_prompt_duration() {
  local -F d=$1
  local LC_NUMERIC=C
  local -i s=$1 ms=$(( d * 1000 ))
  if (( d < 1 )); then REPLY="${ms}ms"
  elif (( d < 60 )); then printf -v REPLY '%.1fs' d
  elif (( s < 3600 )); then printf -v REPLY '%dm%02ds' $(( s / 60 )) $(( s % 60 ))
  else printf -v REPLY '%dh%02dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
  fi
}

_prompt_precmd() {
  local ret=$? dir branch
  local -a right
  _theme_sync
  # only after a command ran: an empty Enter or ^C keeps what the last command left
  if [[ -n $_prompt_start ]]; then
    _prompt_ok=$(( ! ret ))
    _prompt_right=()
    if (( ret )); then
      local sig; (( ret > 128 )) && sig=${signals[ret - 127]}
      _prompt_right+="%F{$thm_red}✘ $ret${sig:+ $sig}%f"
    fi
    local -F took=$(( EPOCHREALTIME - _prompt_start ))
    (( took >= 0.5 )) && _prompt_duration $took && _prompt_right+="%F{$thm_yellow}$REPLY%f"
    unset _prompt_start
  fi
  right=($_prompt_right)
  (( ${#jobstates} )) && right+="%F{$thm_blue}⚙ ${#jobstates}%f"

  # one git call for both; physical paths, so a link into a repo (~/.config/tmux) resolves too
  local -a git=(${(f)"$(command git rev-parse --show-toplevel --abbrev-ref HEAD 2>/dev/null)"})
  if [[ -n $git[1] && ${PWD:A}/ == $git[1]/* ]]; then
    dir=${git[1]:t}${${PWD:A}#$git[1]}
    if [[ -z $TMUX ]]; then
      branch=$git[2]
      command git diff --quiet HEAD 2>/dev/null || branch+='*'
    fi
  else
    dir=${(%):-%~}
  fi

  [[ -n $SSH_CONNECTION ]] && dir="%n@%m:$dir"

  _prompt_left="%F{$thm_blue}${dir//\%/%%}%f"
  [[ -n $branch ]] && _prompt_left+=" %F{$thm_light_grey}${branch//\%/%%}%f"
  local c=$thm_purple; (( _prompt_ok )) || c=$thm_red
  _prompt_char="%F{$c}❯%f"
  PROMPT="$_prompt_left $_prompt_char "
  local sep=" %F{$thm_grey}·%f "
  RPROMPT=${(pj:$sep:)right}
}

# redraws the finished line with only the start time on the right, the left part stays put
_prompt_collapse() {
  [[ $CONTEXT == start ]] || return 0
  PROMPT="$_prompt_left $_prompt_char " RPROMPT="%F{$thm_grey}%D{%H:%M:%S}%f"
  zle .reset-prompt
}

_prompt_ok=1
_prompt_right=()
add-zsh-hook preexec _prompt_preexec
add-zsh-hook precmd _prompt_precmd
add-zle-hook-widget line-finish _prompt_collapse
# ^C on a typed line skips line-finish, collapse it here
TRAPINT() {
  zle && _prompt_collapse
  return $(( 128 + $1 ))
}

command -v fzf >/dev/null && source <(fzf --zsh)
