# delta (https://github.com/dandavison/delta) as git pager, included from ~/.gitconfig
[core]
  # only for git itself: n / N jump between files (their Δ labels are useless in lazygit, where
  # navigate does not work), side by side fits a full-width terminal
  pager = delta --navigate --side-by-side

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3

[delta]
  line-numbers = true
  syntax-theme = gruvbox-material

# gruvbox-material colors; added lines are blue, not green: red vs blue tells apart better.
# +/- markers mark the lines without relying on color
  keep-plus-minus-markers       = true
  minus-style                   = syntax "#3c1f1e"
  minus-non-emph-style          = syntax "#3c1f1e"
  minus-emph-style              = syntax "#442E2D"
  minus-empty-line-marker-style = syntax "#3c1f1e"
  line-numbers-minus-style      = "#EA6962"
  plus-style                    = syntax "#0D3138"
  plus-non-emph-style           = syntax "#0D3138"
  plus-emph-style               = syntax "#2e3b3b"
  plus-empty-line-marker-style  = syntax "#0D3138"
  line-numbers-plus-style       = "#7DAEA3"
  line-numbers-zero-style       = "#504945"
