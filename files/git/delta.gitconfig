# delta (https://github.com/dandavison/delta) as git pager, included from ~/.gitconfig
[core]
  # only for git itself: n / N jump between files (their Δ labels are useless in lazygit, where
  # navigate does not work), side by side fits a full-width terminal
  pager = delta --navigate --side-by-side

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3

[delta]
  line-numbers = false
  hunk-header-style = omit
  # the dark set when DELTA_FEATURES does not pick one (`theme` sets it: zshrc, the tmux environment)
  features = gruvbox-material-dark

# added lines are blue, not green: red vs blue tells apart better.
# deleted lines are red at 15% / 30% over the background: the theme's own diff backgrounds
# (bg_diff_red and the like) are barely visible
# +/- markers mark the lines without relying on color
[delta "gruvbox-material-dark"]
  dark = true
  syntax-theme = gruvbox-material-dark
  keep-plus-minus-markers       = true
  minus-style                   = syntax "#3C2B2B"
  minus-non-emph-style          = syntax "#3C2B2B"
  minus-emph-style              = syntax "#5A3634"
  minus-empty-line-marker-style = syntax "#3C2B2B"
  line-numbers-minus-style      = "#EA6962"
  plus-style                    = syntax "#2B3534"
  plus-non-emph-style           = syntax "#2B3534"
  plus-emph-style               = syntax "#3A4B48"
  plus-empty-line-marker-style  = syntax "#2B3534"
  line-numbers-plus-style       = "#7DAEA3"
  line-numbers-zero-style       = "#7C6F64"

# the same over gruvbox-material light: blue and red at 15% / 30% over its background
[delta "gruvbox-material-light"]
  light = true
  syntax-theme = gruvbox-material-light
  keep-plus-minus-markers       = true
  minus-style                   = syntax "#F1DBC2"
  minus-non-emph-style          = syntax "#F1DBC2"
  minus-emph-style              = syntax "#E8C2AD"
  minus-empty-line-marker-style = syntax "#F1DBC2"
  line-numbers-minus-style      = "#C14A4A"
  plus-style                    = syntax "#DEE1C9"
  plus-non-emph-style           = syntax "#DEE1C9"
  plus-emph-style               = syntax "#C3CDBB"
  plus-empty-line-marker-style  = syntax "#DEE1C9"
  line-numbers-plus-style       = "#45707A"
  line-numbers-zero-style       = "#A89984"
