# delta (https://github.com/dandavison/delta) as git pager, included from ~/.gitconfig
[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3

[delta]
  navigate = true # n / N jump between files
  line-numbers = true
  syntax-theme = kanagawa

# kanagawa wave colors (diff backgrounds from the nvim theme, emphasis blended stronger)
  minus-style                   = syntax "#43242B"
  minus-non-emph-style          = syntax "#43242B"
  minus-emph-style              = syntax "#582b31"
  minus-empty-line-marker-style = syntax "#43242B"
  line-numbers-minus-style      = "#C34043"
  plus-style                    = syntax "#2B3328"
  plus-non-emph-style           = syntax "#2B3328"
  plus-emph-style               = syntax "#3d483f"
  plus-empty-line-marker-style  = syntax "#2B3328"
  line-numbers-plus-style       = "#76946A"
  line-numbers-zero-style       = "#54546D"
