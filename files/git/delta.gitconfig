# delta (https://github.com/dandavison/delta) as git pager, included from ~/.gitconfig
[core]
  # only for git itself: n / N jump between files (their Δ labels are useless in lazygit, where
  # navigate does not work), side by side fits a full-width terminal
  pager = delta --navigate --side-by-side

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3

[delta]
  line-numbers = true
  syntax-theme = kanagawa

# kanagawa wave colors; added lines are blue, not green: red vs blue tells apart better.
# +/- markers mark the lines without relying on color
  keep-plus-minus-markers       = true
  minus-style                   = syntax "#43242B"
  minus-non-emph-style          = syntax "#43242B"
  minus-emph-style              = syntax "#6E2A33"
  minus-empty-line-marker-style = syntax "#43242B"
  line-numbers-minus-style      = "#FF9E3B"
  plus-style                    = syntax "#223249"
  plus-non-emph-style           = syntax "#223249"
  plus-emph-style               = syntax "#2D4F67"
  plus-empty-line-marker-style  = syntax "#223249"
  line-numbers-plus-style       = "#7FB4CA"
  line-numbers-zero-style       = "#54546D"
